---
import { getCollection } from "astro:content";
const footerPages = await getCollection("legal");
---

<footer>
    <nav aria-label="Footer">
        <ul>
            {footerPages.map(page => (
                <li>
                    <a href={`/legal/${page.slug}`}>{page.data.title}</a>
                </li>
            ))}
        </ul>
    </nav>
    <p class="copyright">© {new Date().getFullYear()} Pagels Kindergarten</p>
</footer>

<style>
    footer {
        margin-top: auto;
        background-color: var(--elevated);
        border-top: 1px solid var(--border);
        text-align: center;
        padding: 1rem;
        display: flex;
        align-items: center;
        flex-direction: row;
        justify-content: space-around;
    }

    nav {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    ul {
        list-style: none;
        display: flex;
        gap: 0.5rem 1rem;
        padding: 0.5rem;
        margin: 0;
        flex-wrap: wrap;
        justify-content: center;
    }

    ul li a {
        text-decoration: none;
        color: var(--secondary);
        font-size: 1rem;
        font-weight: 600;
        position: relative;
        padding: 0.25rem 0;
        transition: color 0.3s ease;
    }

    ul li a:hover {
        color: var(--primary);
    }

    ul li a::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 50%;
        width: 0;
        height: 3px;
        background: var(--accent);
        border-radius: 4px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(-50%);
        opacity: 0.7;
    }

    ul li a:hover::after {
        width: 100%;
    }

    .copyright {
        color: var(--secondary);
        font-size: 0.95rem;
        margin: 0;
    }
</style>