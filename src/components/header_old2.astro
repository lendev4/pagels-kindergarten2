---
const navPages = [
    { data: { title: 'Testseite' }, slug: 'test' },
    { data: { title: 'Zweite Testseite' }, slug: 'test2' },
    { data: { title: 'Dritte Testseite' }, slug: 'test3' },
    { data: { title: 'Vierte Testseite' }, slug: 'test4' },
    { data: { title: 'Fünfte Testseite' }, slug: 'test5' },
]

const allNavItems = [
    { title: 'Startseite', href: '/' },
    { title: 'Galerie', href: '/galerie' },
    ...navPages.map(page => ({ title: page.data.title, href: `/${page.slug}` }))
];
---

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">

<header class="site-header" id="main-header">
    <div class="header-inner">
        <a href="/" class="logo-link">
            <img src="/uploads/logo.png" alt="Pagels Kindergarten" class="logo" width="200" height="60" />
        </a>

        <!-- Hamburger Icon -->
        <button 
            id="menu-toggle" 
            class="menu-toggle" 
            aria-label="Menü öffnen" 
            aria-expanded="false"
        >
            <span class="hamburger-box">
                <span class="hamburger-inner"></span>
            </span>
        </button>

        <!-- Navigation -->
        <nav class="main-nav" id="main-nav" aria-label="Hauptnavigation">
            <ul class="nav-list">
                {allNavItems.map((item) => (
                    <li><a href={item.href}>{item.title}</a></li>
                ))}
            </ul>
        </nav>
        
        <div class="overlay" id="overlay"></div>
    </div>
</header>

<script>
    const header = document.getElementById('main-header');
    const toggleBtn = document.getElementById('menu-toggle');
    const overlay = document.getElementById('overlay');
    const navLinks = document.querySelectorAll('.nav-list a');

    function toggleMenu(forceClose = false) {
        if (!toggleBtn || !header) return;
        
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        const newState = forceClose ? false : !isExpanded;

        toggleBtn.setAttribute('aria-expanded', String(newState));
        header.classList.toggle('nav-open', newState);
        
        // Lock scroll only on small screens
        if (window.innerWidth <= 1100) {
            document.body.style.overflow = newState ? 'hidden' : '';
        }
    }

    // Event Listeners
    toggleBtn?.addEventListener('click', () => toggleMenu());
    overlay?.addEventListener('click', () => toggleMenu(true));
    navLinks.forEach(link => link.addEventListener('click', () => toggleMenu(true)));
    
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggleMenu(true);
    });

    // Resize Handler: Stops animations firing during resize
    let resizeTimer: number;
    window.addEventListener('resize', () => {
        document.body.classList.add('no-transition');
        
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            document.body.classList.remove('no-transition');
        }, 200);

        if (window.innerWidth > 1100) {
            toggleMenu(true);
            document.body.style.overflow = '';
        }
    });
</script>

<style>
    :root {
        /* Minimalist Waldorf Palette */
        --c-bg: #fff4e6;
        --c-text: #7a2e2e;
        --c-accent: #d4a373;
        --c-overlay: rgba(60, 40, 40, 0.2);
        
        --font-main: 'Lora', serif;
        --h-height: 90px;
    }

    /* Global Utils */
    :global(.no-transition *) {
        transition: none !important;
        animation: none !important;
    }

    .site-header {
        background: var(--c-bg);
        height: var(--h-height);
        position: sticky;
        top: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        padding: 0 5%;
        border-bottom: 1px solid rgba(212, 163, 115, 0.2); /* Soft border */
    }

    .header-inner {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo {
        height: 50px;
        width: auto;
        display: block;
    }

    /* Desktop Navigation */
    .nav-list {
        display: flex;
        gap: 2.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-list a {
        text-decoration: none;
        white-space: nowrap;
        color: var(--c-text);
        font-family: var(--font-main);
        font-size: 1.05rem;
        font-weight: 500;
        position: relative;
        padding-bottom: 4px;
        transition: opacity 0.3s ease;
    }

    .nav-list a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background: var(--c-text);
        transition: width 0.3s ease;
    }

    .nav-list a:hover {
        opacity: 0.8;
    }

    .nav-list a:hover::after {
        width: 100%;
    }

    .menu-toggle, .overlay {
        display: none;
    }

    /* --- Mobile / Tablet (< 1100px) --- */
    @media screen and (max-width: 1100px) {
        
        /* 1. Hamburger Button */
        .menu-toggle {
            display: flex;
            padding: 0;
            width: 30px; 
            height: 24px;
            background: none;
            border: none;
            cursor: pointer;
            z-index: 1002;
            position: relative;
            align-items: center;
            justify-content: center;
        }

        .hamburger-box {
            width: 30px;
            height: 24px;
            position: relative;
        }

        .hamburger-inner, .hamburger-inner::before, .hamburger-inner::after {
            width: 30px;
            height: 2px;
            background-color: var(--c-text);
            position: absolute;
            transition: transform 0.2s ease, top 0.2s ease;
            border-radius: 2px;
            left: 0;
        }

        .hamburger-inner { top: 11px; }
        .hamburger-inner::before { content: ''; top: -8px; }
        .hamburger-inner::after { content: ''; top: 8px; }

        /* Hamburger Active State (Simple X) */
        button[aria-expanded="true"] .hamburger-inner {
            background-color: transparent;
        }
        button[aria-expanded="true"] .hamburger-inner::before {
            top: 0;
            transform: rotate(45deg);
        }
        button[aria-expanded="true"] .hamburger-inner::after {
            top: 0;
            transform: rotate(-45deg);
        }

        /* 2. Sidebar Navigation */
        .main-nav {
            position: fixed;
            top: 0;
            right: 0;
            height: 100vh;
            width: 280px;
            background: var(--c-bg);
            padding-top: calc(var(--h-height) + 20px);
            padding-left: 2rem;
            padding-right: 2rem;
            
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
            z-index: 1001;
            box-shadow: -5px 0 20px rgba(0,0,0,0.05);
        }

        .site-header.nav-open .main-nav {
            transform: translateX(0);
        }

        .nav-list {
            flex-direction: column;
            gap: 1.5rem;
            align-items: flex-start;
        }

        .nav-list a {
            font-size: 1.25rem;
            display: block;
            width: 100%;
        }
        
        .nav-list a::after {
            display: none; /* No underline on mobile */
        }

        /* 3. Overlay */
        .overlay {
            display: block;
            position: fixed;
            inset: 0;
            background: var(--c-overlay);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease;
            z-index: 999;
            backdrop-filter: blur(2px);
        }

        .site-header.nav-open .overlay {
            opacity: 1;
            visibility: visible;
        }
    }
</style>