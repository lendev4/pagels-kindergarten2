<div id="lightbox" hidden inert role="dialog" aria-modal="true" aria-label="Bildvorschau">
    <div class="lightbox-loader" aria-hidden="true">
        <svg class="spinner" viewBox="0 0 50 50">
            <circle cx="25" cy="25" r="20" fill="none" stroke="currentColor" stroke-width="4"></circle>
        </svg>
    </div>
    <button class="lightbox-close" type="button" aria-label="Schließen">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <div class="lightbox-content">
        <img alt="" class="lightbox-image">
        <div class="lightbox-controls">
            <button class="lightbox-nav lightbox-prev" type="button" aria-label="Vorheriges Bild" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="lightbox-nav lightbox-next" type="button" aria-label="Nächstes Bild" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>
    </div>
</div>

<script>
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>('.lightbox-image');
    const closeButton = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
    const prevButton = lightbox?.querySelector<HTMLButtonElement>('.lightbox-prev');
    const nextButton = lightbox?.querySelector<HTMLButtonElement>('.lightbox-next');

    let galleryImages: HTMLImageElement[] = [];
    let currentIndex = 0;
    let previouslyFocusedElement: HTMLElement | null = null;
    const focusableElements = [closeButton, prevButton, nextButton].filter(Boolean) as HTMLElement[];
    
    // Single source of truth for state
    const state = {
        x: 0,
        y: 0,
        scale: 1,
        isDragging: false,
        isPinching: false,
        active: false
    };

    // Physics configuration
    const FRICTION = 0.9;
    const BOUNCE_STIFFNESS = 0.2;
    const ZOOM_MAX = 4;
    const VELOCITY_MULTIPLIER = 25; // Increased for better mobile response
    
    // Interaction tracking
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let lastY = 0;
    let startScale = 1;
    let startDist = 0;
    let pinchCenter = { x: 0, y: 0 };
    
    // Velocity tracking
    let vx = 0;
    let vy = 0;
    let lastTime = 0;
    let rafId: number | null = null;
    let swipeDirection: 'h' | 'v' | null = null; // Track swipe axis

    const getBounds = (scale: number) => {
        if (!lightboxImage) return { minX: 0, maxX: 0, minY: 0, maxY: 0 };
        const winW = window.innerWidth;
        const winH = window.innerHeight;
        
        // If scale is small, strictly enforce layout position (0,0)
        if (scale <= 1) return { minX: 0, maxX: 0, minY: 0, maxY: 0 };

        const imgW = lightboxImage.offsetWidth * scale;
        const imgH = lightboxImage.offsetHeight * scale;

        const rangeX = imgW > winW ? (imgW - winW) / 2 : 0;
        const rangeY = imgH > winH ? (imgH - winH) / 2 : 0;

        return { 
            minX: -rangeX, 
            maxX: rangeX, 
            minY: -rangeY, 
            maxY: rangeY 
        };
    };

    const render = (instant = false) => {
        if (!lightboxImage) return;
        
        // Toggle class for CSS to handle visibility
        if (state.scale > 1.01) {
            lightbox?.classList.add('zoomed-mode');
        } else {
            lightbox?.classList.remove('zoomed-mode');
        }

        if (state.isDragging || state.isPinching || instant) {
            lightboxImage.style.transition = 'none';
        } else {
            lightboxImage.style.transition = 'transform 0.3s cubic-bezier(0.2, 0, 0.2, 1)';
        }

        lightboxImage.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.scale})`;
        
        if (state.scale > 1.01) {
            lightboxImage.classList.add('zoomed');
        } else {
            lightboxImage.classList.remove('zoomed');
        }
    };

    const updatePhysics = () => {
        if (!state.active) {
            rafId = null;
            return;
        }
        if (state.isDragging || state.isPinching) {
            rafId = requestAnimationFrame(updatePhysics);
            return;
        }

        let changed = false;
        
        // 1. Scale snap-back (must happen FIRST)
        if (state.scale < 1) {
            state.scale += (1 - state.scale) * 0.3;
            if (state.scale > 0.99) state.scale = 1;
            changed = true;
        }

        const { minX, maxX, minY, maxY } = getBounds(state.scale);

        // 2. Apply momentum (only when zoomed)
        if (state.scale > 1 && (Math.abs(vx) > 0.1 || Math.abs(vy) > 0.1)) {
            state.x += vx;
            state.y += vy;
            vx *= FRICTION;
            vy *= FRICTION;
            changed = true;
        } else {
            vx = 0;
            vy = 0;
        }

        // 3. Bounds enforcement / rubber-band
        if (state.x > maxX) {
            state.x += (maxX - state.x) * 0.3;
            if (Math.abs(state.x - maxX) < 0.5) state.x = maxX;
            changed = true;
        } else if (state.x < minX) {
            state.x += (minX - state.x) * 0.3;
            if (Math.abs(state.x - minX) < 0.5) state.x = minX;
            changed = true;
        }
        
        if (state.y > maxY) {
            state.y += (maxY - state.y) * 0.3;
            if (Math.abs(state.y - maxY) < 0.5) state.y = maxY;
            changed = true;
        } else if (state.y < minY) {
            state.y += (minY - state.y) * 0.3;
            if (Math.abs(state.y - minY) < 0.5) state.y = minY;
            changed = true;
        }

        // 4. Force center when at scale 1
        if (state.scale === 1 && (state.x !== 0 || state.y !== 0)) {
            state.x += (0 - state.x) * 0.3;
            state.y += (0 - state.y) * 0.3;
            if (Math.abs(state.x) < 0.5) state.x = 0;
            if (Math.abs(state.y) < 0.5) state.y = 0;
            changed = true;
        }

        if (changed) {
            render(true);
            rafId = requestAnimationFrame(updatePhysics);
        } else {
            rafId = null;
        }
    };

    const startPhysicsLoop = () => {
        if (!rafId) rafId = requestAnimationFrame(updatePhysics);
    };

    const getDistance = (touches: TouchList) => {
        return Math.hypot(
            touches[0].clientX - touches[1].clientX,
            touches[0].clientY - touches[1].clientY
        );
    };

    const getCenter = (touches: TouchList) => {
        return {
            x: (touches[0].clientX + touches[1].clientX) / 2,
            y: (touches[0].clientY + touches[1].clientY) / 2
        };
    };

    const resetState = (options: { preserveBackground?: boolean; skipRender?: boolean } = {}) => {
        state.x = 0; 
        state.y = 0;
        state.scale = 1;
        state.isDragging = false;
        state.isPinching = false;
        vx = 0; 
        vy = 0;
        if (lightbox && !options.preserveBackground) lightbox.style.background = '';
        if (!options.skipRender) render();
    };

    // --- Helpers ---
    const getAdjacentImages = (img: HTMLImageElement): HTMLImageElement[] => {
        // Find parent gallery container (look for common gallery patterns)
        const container = img.closest('.gallery, .images, [class*="gallery"], [class*="grid"], main');
        if (!container) return [img];
        
        // Get all images within the container
        const allImages = Array.from(container.querySelectorAll('img')) as HTMLImageElement[];
        
        // Filter to only include visible images (not icons, avatars, etc.)
        const galleryImgs = allImages.filter(i => {
            const rect = i.getBoundingClientRect();
            return rect.width > 100 && rect.height > 100; // Minimum size threshold
        });
        
        return galleryImgs.length > 0 ? galleryImgs : [img];
    };

    const updateNavigation = () => {
        if (!prevButton || !nextButton) return;
        const hasMultiple = galleryImages.length > 1;
        const hasPrev = currentIndex > 0;
        const hasNext = currentIndex < galleryImages.length - 1;
        prevButton.hidden = !hasMultiple;
        nextButton.hidden = !hasMultiple;
        prevButton.disabled = !hasPrev;
        nextButton.disabled = !hasNext;
    };

    const showImage = (img: HTMLImageElement) => {
        if (!lightbox || !lightboxImage) return;
        
        lightboxImage.src = '';
        resetState();
        lightbox.classList.add('loading');
        
        lightboxImage.onload = () => lightbox.classList.remove('loading');
        lightboxImage.onerror = () => lightbox.classList.remove('loading');
        
        lightboxImage.src = img.src;
        lightboxImage.alt = img.alt || '';
        
        updateNavigation();
    };

    const openLightbox = (img: HTMLImageElement) => {
        if (!lightbox || !lightboxImage) return;
        
        // Store previously focused element for restoration
        previouslyFocusedElement = document.activeElement as HTMLElement;
        
        galleryImages = getAdjacentImages(img);
        currentIndex = galleryImages.indexOf(img);
        
        showImage(img);
        
        lightbox.removeAttribute('hidden');
        lightbox.removeAttribute('inert');
        lightbox.classList.add('active');
        state.active = true;
        document.body.style.overflow = 'hidden';
        
        // Push state for back button handling
        history.pushState({ lightbox: 'open' }, '');
        closeButton?.focus();
    };

    // Internal function to actually modify DOM/state when closing
    const closeLightboxVisual = () => {
        if (!lightbox || !lightboxImage) return;
        
        state.active = false;
        
        // Reset state but DON'T render - keep current visual position
        state.isDragging = false;
        state.isPinching = false;
        vx = 0;
        vy = 0;
        
        // Hide immediately without transition to avoid flash
        lightbox.style.visibility = 'hidden';
        lightbox.classList.remove('active');
        
        // Clean up after a short delay
        setTimeout(() => {
            // Now safe to fully reset everything
            state.x = 0;
            state.y = 0;
            state.scale = 1;
            
            lightboxImage.onload = null;
            lightboxImage.onerror = null;
            lightboxImage.src = '';
            lightboxImage.alt = '';
            lightboxImage.style.transition = '';
            lightboxImage.style.opacity = '';
            lightboxImage.style.transform = '';
            lightbox.style.transition = '';
            lightbox.style.background = '';
            lightbox.style.visibility = '';
            lightbox.setAttribute('hidden', '');
            lightbox.setAttribute('inert', '');
            galleryImages = [];
            currentIndex = 0;
            
            // Reset button styles
            if (closeButton) {
                closeButton.style.transition = '';
                closeButton.style.opacity = '';
            }
            if (prevButton) {
                prevButton.style.transition = '';
                prevButton.style.opacity = '';
            }
            if (nextButton) {
                nextButton.style.transition = '';
                nextButton.style.opacity = '';
            }
            
            // Restore focus to previously focused element
            previouslyFocusedElement?.focus();
            previouslyFocusedElement = null;
        }, 50);
        
        document.body.style.overflow = '';
    };

    // Public / Event handler close (triggers history back)
    const closeLightbox = () => {
        if (!state.active) return;
        history.back();
    };

    // Handle browser back button
    window.addEventListener('popstate', () => {
        if (state.active) {
            closeLightboxVisual();
        }
    });

    const showPrev = () => {
        if (currentIndex > 0) {
            currentIndex--;
            showImage(galleryImages[currentIndex]);
        }
    };

    const showNext = () => {
        if (currentIndex < galleryImages.length - 1) {
            currentIndex++;
            showImage(galleryImages[currentIndex]);
        }
    };

    // --- Inputs ---

    lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) closeLightbox();
    });

    closeButton?.addEventListener('click', closeLightbox);
    prevButton?.addEventListener('click', showPrev);
    nextButton?.addEventListener('click', showNext);
    
    // Gallery trigger
    document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.tagName === 'IMG' && target.closest('main')) {
            openLightbox(target as HTMLImageElement);
        }
    });

    // MOUSE DYNAMICS
    lightboxImage?.addEventListener('mousedown', (e) => {
        if (state.scale > 1) {
            e.preventDefault();
            state.isDragging = true;
            startX = e.clientX - state.x;
            startY = e.clientY - state.y;
            lastX = e.clientX;
            lastY = e.clientY;
            lastTime = Date.now();
            lightboxImage.classList.add('grabbing');
            startPhysicsLoop();
        }
    });

    window.addEventListener('mousemove', (e) => {
        if (state.isDragging) {
            e.preventDefault();
            const now = Date.now();
            // Move
            state.x = e.clientX - startX;
            state.y = e.clientY - startY;
            
            // Calc velocity
            const dt = now - lastTime;
            if (dt > 0) {
                const newVx = (e.clientX - lastX) / dt * VELOCITY_MULTIPLIER;
                const newVy = (e.clientY - lastY) / dt * VELOCITY_MULTIPLIER;
                vx = vx * 0.5 + newVx * 0.5;
                vy = vy * 0.5 + newVy * 0.5;
            }
            
            lastX = e.clientX;
            lastY = e.clientY;
            lastTime = now;
            render(true);
        }
    });

    window.addEventListener('mouseup', () => {
        if (state.isDragging) {
            state.isDragging = false;
            lightboxImage?.classList.remove('grabbing');
            startPhysicsLoop();
        }
    });

    // TOUCH DYNAMICS
    lightboxImage?.addEventListener('touchstart', (e) => {
        vx = 0; vy = 0; // stop drift on touch
        swipeDirection = null; // Reset swipe lock
        
        if (e.touches.length === 1) {
            // Always prepare tracking variables
            state.isPinching = false;
            startX = e.touches[0].clientX - state.x;
            startY = e.touches[0].clientY - state.y;
            lastX = e.touches[0].clientX;
            lastY = e.touches[0].clientY;
            lastTime = Date.now();
            
            // Only capture drag immediately if zoomed
            if (state.scale > 1) {
                state.isDragging = true;
                lightboxImage.classList.add('grabbing');
            }
        } else if (e.touches.length === 2) {
            e.preventDefault();
            state.isDragging = false;
            state.isPinching = true;
            startDist = getDistance(e.touches);
            startScale = state.scale;
            pinchCenter = getCenter(e.touches);
        }
        startPhysicsLoop();
    }, { passive: false });

    lightboxImage?.addEventListener('touchmove', (e) => {
        // SWIPE ACTIVATION LOGIC (Scale 1 only)
        if (!state.isDragging && !state.isPinching && state.scale === 1 && e.touches.length === 1) {
            const dx = e.touches[0].clientX - lastX;
            const dy = e.touches[0].clientY - lastY;
            const dist = Math.hypot(dx, dy);
            
            // 10px Deadzone to detect intent
            if (dist > 10) {
                 if (Math.abs(dx) > Math.abs(dy)) {
                     swipeDirection = 'h';
                 } else {
                     // Only allow swipe down (dy > 0) to trigger V-swipe
                     const totalDy = e.touches[0].clientY - startY;
                     if (totalDy > 0) swipeDirection = 'v';
                 }

                 if (swipeDirection) {
                     state.isDragging = true;
                     lightboxImage.classList.add('grabbing');
                     
                     // CRITICAL: Reset start origins to current position to prevent "pop" glitch
                     // when crossing the deadzone threshold.
                     startX = e.touches[0].clientX;
                     startY = e.touches[0].clientY;
                 }
            }
        }

        if (state.isDragging && e.touches.length === 1) {
            e.preventDefault();
            const currX = e.touches[0].clientX;
            const currY = e.touches[0].clientY;

            if (state.scale === 1) {
                // --- SWIPE LOGIC (Locked Axis) ---
                if (swipeDirection === 'h') {
                    // Calculate raw delta
                    let x = currX - startX;
                    const hasPrev = currentIndex > 0;
                    const hasNext = currentIndex < galleryImages.length - 1;

                    // Strictly block movement if no image exists in that direction
                    // Prevents the "stuck" rubber-band feeling
                    if (x > 0 && !hasPrev) x = 0;
                    else if (x < 0 && !hasNext) x = 0;

                    state.x = x;
                    state.y = 0;
                
                } else if (swipeDirection === 'v') {
                    const rawY = currY - startY; // Actual finger movement
                    
                    if (rawY > 0) {
                        // Image moves 1.5x faster than finger
                        state.y = rawY * 1.5;
                        
                        // Progress: 0 to 1 based on finger movement (100px = full progress)
                        const progress = Math.min(rawY / 100, 1);
                        
                        // Background fades
                        lightbox!.style.background = `rgba(0, 0, 0, ${0.95 * (1 - progress)})`;
                        
                        // Buttons fade out
                        const buttonOpacity = String(1 - progress);
                        if (closeButton) closeButton.style.opacity = buttonOpacity;
                        if (prevButton) prevButton.style.opacity = buttonOpacity;
                        if (nextButton) nextButton.style.opacity = buttonOpacity;
                    } else {
                        // Resist swipe up
                        state.y = rawY * 0.1;
                    }
                    
                    state.x = 0;
                }

            } else {
                // --- ZOOMED PAN LOGIC ---
                // Recalculate startX/startY on the fly implies we need to handle offset
                // But we are using tracked startX from touchstart.
                
                const x = currX - startX;
                const y = currY - startY;
                const { minX, maxX, minY, maxY } = getBounds(state.scale);

                // Rubberbanding
                if (x > maxX) {
                    state.x = maxX + (x - maxX) * 0.3;
                } else if (x < minX) {
                    state.x = minX + (x - minX) * 0.3;
                } else {
                    state.x = x;
                }

                if (y > maxY) {
                    state.y = maxY + (y - maxY) * 0.3;
                } else if (y < minY) {
                    state.y = minY + (y - minY) * 0.3;
                } else {
                    state.y = y;
                }
            }

            // Velocity tracking
            const now = Date.now();
            const dt = now - lastTime;
            if (dt > 0) {
                const newVx = (currX - lastX) / dt * VELOCITY_MULTIPLIER;
                const newVy = (currY - lastY) / dt * VELOCITY_MULTIPLIER;
                vx = vx * 0.5 + newVx * 0.5;
                vy = vy * 0.5 + newVy * 0.5;
            }
            lastX = currX;
            lastY = currY;
            lastTime = now;
            
            render(true);

        } else if (state.isPinching && e.touches.length === 2) {
            e.preventDefault();
            const newDist = getDistance(e.touches);
            const newCenter = getCenter(e.touches);
            
            // New scale
            const scale = startScale * (newDist / startDist);
            const newScale = Math.min(Math.max(0.5, scale), ZOOM_MAX);
            
            // Pan correction (zoom towards pinch center)
            const winCX = window.innerWidth / 2;
            const winCY = window.innerHeight / 2;
            
            // Point on image under center
            const pointX = (pinchCenter.x - winCX - state.x) / state.scale;
            const pointY = (pinchCenter.y - winCY - state.y) / state.scale;
            
            state.scale = newScale;
            // newPos = center - (point * newScale) - offsetCenter
            state.x = (newCenter.x - winCX) - (pointX * state.scale);
            state.y = (newCenter.y - winCY) - (pointY * state.scale);
            
            pinchCenter = newCenter;
            render(true);
        }
    }, { passive: false });

    lightboxImage?.addEventListener('touchend', (e) => {
        if (state.isPinching && e.touches.length < 2) {
            state.isPinching = false;
            vx = 0;
            vy = 0;
            
            // Transition to drag if finger remains
            if (e.touches.length === 1) {
                state.isDragging = true;
                startX = e.touches[0].clientX - state.x;
                startY = e.touches[0].clientY - state.y;
                lastX = e.touches[0].clientX;
                lastY = e.touches[0].clientY;
            }
            
            // Always start physics to handle snap-back
            startPhysicsLoop();
        } else if (state.isDragging && e.touches.length === 0) {
            state.isDragging = false;
            lightboxImage?.classList.remove('grabbing');
            
            // ACTION TRIGGER LOGIC
            if (swipeDirection === 'h') {
                const triggerThreshold = window.innerWidth / 4;
                const velocityThreshold = 1.5;

                const hasPrev = currentIndex > 0;
                const hasNext = currentIndex < galleryImages.length - 1;

                if ((state.x < -triggerThreshold || vx < -velocityThreshold) && hasNext) {
                    showNext();
                } else if ((state.x > triggerThreshold || vx > velocityThreshold) && hasPrev) {
                    showPrev();
                } else {
                     // CANCELLED SWIPE:
                     // Kill velocity to prevent momentum from fighting the snap-back.
                     // The physics loop will now purely rubber-band state.x back to 0.
                     vx = 0; 
                     vy = 0;
                }
                
            } else if (swipeDirection === 'v') {
                // Image at 180px (90px finger movement) or velocity triggers close
                const triggerThreshold = 180;
                const velocityThreshold = 5;

                if (state.y > triggerThreshold || vy > velocityThreshold) {
                    // STOP physics loop - we're animating manually
                    if (rafId) {
                        cancelAnimationFrame(rafId);
                        rafId = null;
                    }
                    
                    // Animate image continuing downward, then close
                    if (lightboxImage) {
                        lightboxImage.style.transition = 'transform 0.2s ease-out, opacity 0.2s ease-out';
                        lightboxImage.style.transform = `translate(0px, ${window.innerHeight + 100}px) scale(1)`;
                        lightboxImage.style.opacity = '0';
                        lightbox!.style.transition = 'background 0.2s ease-out';
                        lightbox!.style.background = 'rgba(0, 0, 0, 0)';
                    }
                    
                    // Fade out buttons
                    if (closeButton) {
                        closeButton.style.transition = 'opacity 0.15s ease-out';
                        closeButton.style.opacity = '0';
                    }
                    if (prevButton) {
                        prevButton.style.transition = 'opacity 0.15s ease-out';
                        prevButton.style.opacity = '0';
                    }
                    if (nextButton) {
                        nextButton.style.transition = 'opacity 0.15s ease-out';
                        nextButton.style.opacity = '0';
                    }
                    
                    setTimeout(() => {
                        // Reset button styles
                        if (closeButton) {
                            closeButton.style.transition = '';
                            closeButton.style.opacity = '';
                        }
                        if (prevButton) {
                            prevButton.style.transition = '';
                            prevButton.style.opacity = '';
                        }
                        if (nextButton) {
                            nextButton.style.transition = '';
                            nextButton.style.opacity = '';
                        }
                        // Push history state so back() works, then close
                        history.back();
                    }, 220);
                    
                    swipeDirection = null;
                    return; // Don't start physics loop
                } else {
                    // Cancelled - snap back
                    vx = 0;
                    vy = 0;
                    lightbox!.style.background = '';
                    // Reset button opacity
                    if (closeButton) closeButton.style.opacity = '';
                    if (prevButton) prevButton.style.opacity = '';
                    if (nextButton) nextButton.style.opacity = '';
                }
            }
            
            swipeDirection = null; // Clean up
            startPhysicsLoop(); // Only runs for cancelled swipes
        }
    });

    // Double Tap
    let lastTapTime = 0;
    lightboxImage?.addEventListener('touchend', (e) => {
        if (state.isDragging || state.isPinching) return;
        if (e.changedTouches.length !== 1) return;

        const now = Date.now();
        const timeDiff = now - lastTapTime;
        
        if (timeDiff < 300 && timeDiff > 0) {
            e.preventDefault();
            if (state.scale === 1) {
                // Zoom in
                const touch = e.changedTouches[0];
                const winCX = window.innerWidth / 2;
                const winCY = window.innerHeight / 2;
                const targetScale = 2.5;
                
                const offsetX = touch.clientX - winCX;
                const offsetYTap = touch.clientY - winCY;
                
                state.x = -offsetX * (targetScale - 1);
                state.y = -offsetYTap * (targetScale - 1);
                state.scale = targetScale;
            } else {
                resetState();
            }
            render();
            lastTapTime = 0;
        } else {
            lastTapTime = now;
        }
    });

    // Mouse Wheel
    lightbox?.addEventListener('wheel', (e) => {
        if (!lightboxImage) return;
        e.preventDefault();
        
        // Determine zoom
        const delta = e.deltaY * -0.005;
        let newScale = state.scale + delta;
        newScale = Math.min(Math.max(1, newScale), ZOOM_MAX);
        
        if (newScale !== state.scale) {
            // Zoom towards mouse
            const rect = lightboxImage.getBoundingClientRect();
            // We need logic similar to pinch but for mouse
            // Mouse pos relative to screen center
            const winCX = window.innerWidth / 2;
            const winCY = window.innerHeight / 2;
            const mouseX = e.clientX - winCX;
            const mouseY = e.clientY - winCY;
            
            // Point on image relative to center
            const pointX = (mouseX - state.x) / state.scale;
            const pointY = (mouseY - state.y) / state.scale;
            
            state.scale = newScale;
            state.x = mouseX - (pointX * state.scale);
            state.y = mouseY - (pointY * state.scale);
            
            render(true);
            
            // Clean up bounds in physics loop
            startPhysicsLoop();
        }
    }, { passive: false });

    // Keyboard
    document.addEventListener('keydown', (event) => {
        if (!lightbox?.classList.contains('active')) return;
        
        switch (event.key) {
            case 'Escape': 
                closeLightbox(); 
                break;
            case 'ArrowLeft': 
                showPrev(); 
                break;
            case 'ArrowRight': 
                showNext(); 
                break;
            case 'Tab':
                // Focus trap
                event.preventDefault();
                const visibleFocusable = focusableElements.filter(el => {
                    const btn = el as HTMLButtonElement;
                    return !btn.hidden && !btn.disabled && el.offsetParent !== null;
                });
                if (visibleFocusable.length === 0) return;
                
                const currentIdx = visibleFocusable.indexOf(document.activeElement as HTMLElement);
                let nextIdx: number;
                
                if (event.shiftKey) {
                    nextIdx = currentIdx <= 0 ? visibleFocusable.length - 1 : currentIdx - 1;
                } else {
                    nextIdx = currentIdx >= visibleFocusable.length - 1 ? 0 : currentIdx + 1;
                }
                
                visibleFocusable[nextIdx]?.focus();
                break;
        }
    });
</script>

