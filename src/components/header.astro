---
import { getCollection } from "astro:content";
const navPages = await getCollection("pages");

const allNavItems = [
    { title: 'Startseite', href: '/' },
    ...navPages
        .filter(page => page.data.nav == true)
        .sort((a, b) => {
            const orderA = a.data.nav_order ?? Infinity;
            const orderB = b.data.nav_order ?? Infinity;
            return orderA - orderB;
        })
        .map(page => ({ title: page.data.nav_label || page.data.title, href: `/${page.slug}` })),
    { title: 'Galerie', href: '/galerie' },
];
---

<header class="elevated">
    <nav>
        <a href="/" class="logo-link">
            <img src="/uploads/logo.png" alt="Pagels Kindergarten" class="logo" />
        </a>

        <button class="hamburger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav" type="button">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <ul id="main-nav">
            {allNavItems.map(item => (
                <li>
                    <a href={item.href}>{item.title}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>

<script>
    const hamburger = document.querySelector('.hamburger');
    const navMenu = document.getElementById('main-nav');

    if (hamburger && navMenu) {
        hamburger.addEventListener('click', () => {
            const isActive = hamburger.classList.contains('active');
            hamburger.classList.toggle('active');
            navMenu.classList.toggle('active');
            hamburger.setAttribute('aria-expanded', String(!isActive));
        });
    }
</script>

<style>
    header {
        padding: 1rem 0;
        text-align: center;
        border-radius: 0;
        border-bottom: 2px solid var(--color-border);
    }

    nav {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    ul {
        list-style: none;
        display: flex;
        gap: 1.5rem;
        padding: 0;
        margin: 0;
        white-space: nowrap;
        flex-direction: row;
        width: 100%;
        flex-wrap: wrap;
        justify-content: center;
    }

    ul li a {
        text-decoration: none;
        /* color: var(--color-text-light); */
        font-size: 1.1rem;
        font-weight: 600;
        position: relative;
        transition: color 0.3s ease;
        padding: 0.5rem 0;
    }

    ul li a:hover {
        color: var(--color-primary-medium);
    }

    ul li a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 3px;
        /* background: var(--color-hover-secondary); */
        border-radius: 4px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(-50%);
        /* opacity: 0.7; */
    }

    ul li a:hover::after {
        width: 100%;
    }

    .hamburger {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 44px;
        height: 40px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 11px;
        z-index: 10;
        margin-left: auto;
        margin-right: 1rem;
    }

    .hamburger span {
        width: 100%;
        height: 3px;
        background-color: var(--color-text-secondary);
        border-radius: 2px;
        transition: all 0.2s cubic-bezier(0.4, 0.82, 0.15, 1.11);
    }

    .hamburger.active span:nth-child(1) {
        transform: translateY(7.5px) rotate(45deg);
    }

    .hamburger.active span:nth-child(2) {
        opacity: 0;
    }

    .hamburger.active span:nth-child(3) {
        transform: translateY(-7.5px) rotate(-45deg);
    }

    .logo {
        max-height: 75px;
        width: auto;
    }

    @media screen and (max-width: 768px) {
        nav {
            justify-content: space-between;
        }
        ul {
            display: none;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
            border-top: 1px solid var(--color-border);
            padding-top: 1rem;
        }
        ul.active {
            display: flex;
        }
        .hamburger {
            display: flex;
        }
        .logo {
            max-width: 240px;
            max-height: 45px;
            padding-left: 1rem;
        }
    }
</style>