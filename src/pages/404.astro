---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden">
	<section class="not-found">
		<h1>Seite nicht gefunden</h1>
		<p>Die Seite existiert nicht (mehr). Bitte nutze die Navigation oben.</p>
		<a href="/">Zur Startseite</a>
	</section>
</Layout>

<style>
	.not-found {
		max-width: 600px;
		margin: 2rem auto 4rem;
		padding: 2rem;
		background: #fff;
		border-radius: 12px;
		/* box-shadow: 0 6px 18px rgba(0,0,0,0.08); */
		text-align: center;
	}

	.not-found h1 {
		margin-bottom: 0.5rem;
	}

	.not-found a {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.5rem 1rem;
		background: var(--secondary);
		color: #fff;
		text-decoration: none;
		border-radius: 999px;
	}

	.not-found a:hover {
		background: color-mix(in srgb, var(--secondary) 80%, black);
	}
</style>
