---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const homepage = await getEntry('homepage', 'homepage');

if (!homepage) {
	throw new Error('Homepage content missing: src/content/homepage/homepage.yml');
}

const { Content } = await homepage.render();

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<main>
		<div class="hero">
			<blockquote>
				<p>{homepage.data.quote}</p>
				<cite>{homepage.data.quote_author}</cite>
			</blockquote>
			{homepage.data.cover_image && <img src={homepage.data.cover_image} alt="Titelbild" />}
		</div>
		<h1>{homepage.data.headline}</h1>
		<Content />
	</main>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
		margin-bottom: 1.5rem;
	}
	@media (min-width: 800px) {
		.hero {
			grid-template-columns: 0.9fr 1.1fr;
		}
	}
	.hero img {
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		border-radius: 14px;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
	}
	blockquote {
		margin: 0;
		padding: 1.2rem 1.4rem;
		background: var(--elevated);
		border-left: 5px solid var(--accent);
		border-radius: 14px;
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
		color: var(--secondary);
	}
	blockquote p {
		font-size: clamp(1.3rem, 1.8vw, 1.7rem);
		font-family: "Antropos Freefont", serif;
		line-height: 1.4;
		margin: 0 0 0.5rem;
	}
	blockquote cite {
		font-style: normal;
		font-weight: 600;
		color: var(--secondary);
	}
</style>