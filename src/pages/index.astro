---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const homepage = await getEntry('homepage', 'homepage');
const sectionEntries = await getCollection('homepage_sections');

if (!homepage) {
    throw new Error('Homepage content missing: src/content/homepage/homepage.yml');
}
---
<Layout>
	<section>
		<div class="content">
			<h1>{homepage.data.headline}</h1>
			<div class="hero">
				<blockquote>
					<p>{homepage.data.quote}</p>
					<cite>{homepage.data.quote_author}</cite>
				</blockquote>
				
				{homepage.data.cover_image && <img class="cover_image" src={homepage.data.cover_image} alt="Titelbild" />}
			</div>
		</div>
	</section>

	{sectionEntries
		.sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
		.map(async (section) => {
		const { Content } = await section.render();
		return (
			<section class={section.data.color}>
				<div class={`content section-block ${section.data.image_on_left ? 'image-left' : ''}`}>
					<div class="section-text">
						<h2>{section.data.section_title}</h2>
						{Content && <Content />}
					</div>
					{section.data.section_image && (
						<div class="section-media">
							<img
								class="section-image"
								src={section.data.section_image}
								alt={section.data.section_title}
								loading="lazy"
							/>
						</div>
					)}
				</div>
			</section>
		);
	})}
</Layout>

<style>
	.hero {
		margin-top: clamp(1.5rem, 2vw, 2.5rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
		/* margin-bottom: 2rem; */
	}
	@media (min-width: 800px) {
		.hero {
			grid-template-columns: 0.9fr 1.1fr;
		}
	}
	.hero img {
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		margin: 0;
	}
	blockquote {
		margin: 0;
		margin-top: clamp(0.5rem, 1.5vw, 1rem);
		padding: 0.5rem 1.5rem;
		border-left: 2px solid var(--color-hover-accent);
		color: var(--color-text-light);
	}
	blockquote p {
		font-size: clamp(1.3rem, 1.8vw, 1.7rem);
		font-family: "Antropos Freefont", serif;
		line-height: 1.6;
		margin: 0 0 0.5rem;
		margin-bottom: 0.8rem;
	}
	blockquote cite {
		font-style: normal;
		font-weight: 400;
		color: var(--color-text-light);
		display: block;
		font-size: 0.95rem;
	}
	.section-block {
		display: flex;
		flex-direction: column;
		gap: 0rem 2rem;
		align-items: stretch;
	}
	.section-text {
		flex: 1 1 auto;
	}
	.section-text h2 {
		margin-top: 0;
	}
	.section-media {
		margin: 0;
		max-height: 420px;
		overflow: hidden;
		flex: 1 1 320px;
	}
	.section-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
		display: block;
	}
	@media (min-width: 800px) {
		.section-block {
			flex-direction: row;
			align-items: start;
		}
		.section-block.image-left {
			flex-direction: row-reverse;
		}
		.section-text {
			min-width: 360px;
			flex: 1 1 360px;
		}
		.section-media {
			max-width: 520px;
			flex: 1 1 360px;
		}
	}
</style>