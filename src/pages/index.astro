---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const homepage = await getEntry('homepage', 'homepage');

if (!homepage) {
	throw new Error('Homepage content missing: src/content/homepage/homepage.yml');
}

const { Content } = await homepage.render();
---

<Layout>
	<section>
		<div class="content">
			<h1>{homepage.data.headline}</h1>
			<div class="hero">
				<blockquote>
					<p>{homepage.data.quote}</p>
					<cite>{homepage.data.quote_author}</cite>
				</blockquote>
				
				{homepage.data.cover_image && <img class="cover_image" src={homepage.data.cover_image} alt="Titelbild" />}
			</div>
		</div>
	</section>

	<section class="blue">
		<div class="content">
			<Content />
		</div>
	</section>
</Layout>

<style>
	.hero {
		margin-top: clamp(1.5rem, 2vw, 2.5rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
		/* margin-bottom: 2rem; */
	}
	@media (min-width: 800px) {
		.hero {
			grid-template-columns: 0.9fr 1.1fr;
		}
	}
	.hero img {
		width: 100%;
		max-height: 420px;
		object-fit: cover;
		margin: 0;
	}
	blockquote {
		margin: 0;
		margin-top: clamp(0.5rem, 1.5vw, 1rem);
		padding: 0.5rem 1.5rem;
		border-left: 2px solid var(--color-hover-accent);
		color: var(--color-text-light);
	}
	blockquote p {
		font-size: clamp(1.3rem, 1.8vw, 1.7rem);
		font-family: "Antropos Freefont", serif;
		line-height: 1.6;
		margin: 0 0 0.5rem;
		margin-bottom: 0.8rem;
	}
	blockquote cite {
		font-style: normal;
		font-weight: 400;
		color: var(--color-text-light);
		display: block;
		font-size: 0.95rem;
	}
</style>